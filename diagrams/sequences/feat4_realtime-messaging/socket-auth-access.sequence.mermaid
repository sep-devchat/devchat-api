%%{init: {"themeCSS": ".actor-line{stroke-dasharray:6 6;}.actor-bottom, text.actor-bottom{display:none;}"}}%%
sequenceDiagram
    autonumber
    actor C as client:DevChatClient
    participant SG as guard:SocketGuard
    participant SGateway as gateway:SocketGateway

    C->>SG: Event
    SG->>SG: Check user session
    alt No user session
        SG->>C: Disconnect
    else
        alt Expired session
            SG->>C: Disconnect
        else
            SG->>SGateway: Forward event
            SGateway->>C: Event processed
        end
    end