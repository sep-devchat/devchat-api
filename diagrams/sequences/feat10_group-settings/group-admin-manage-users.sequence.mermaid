---
config:
  themeCSS: >-
    .actor-line{stroke-dasharray:6 6;}.actor-bottom,
    text.actor-bottom{display:none;}
  theme: neo
---
sequenceDiagram
    autonumber
    actor Admin as admin:GroupAdmin
    participant Web as web:GroupSettingsPage
    participant MembersAPI as api:UserGroupController
    participant MemberSvc as svc:UserGroupService
    participant CLS as cls:ClsService<DevChatCls>
    participant UserRepo as repo:UserRepository
    participant UserGroupRepo as repoUG:UserGroupRepository
    participant InviteRepo as repoInv:GroupInvitationRepository
    participant DB as db:Database

    %% Stage 1: Load members for settings screen
    Admin->>Web: Open "Manage Members" tab
    Web->>MembersAPI: GET /group/:id/members
    activate MembersAPI
    MembersAPI->>MemberSvc: getGroupMembers()
    activate MemberSvc
    MemberSvc->>CLS: get("group")
    CLS-->>MemberSvc: { id: groupId }
    MemberSvc->>UserRepo: find({ userGroups.groupId = groupId })
    activate UserRepo
    UserRepo->>DB: SELECT users JOIN user_groups
    activate DB
    DB-->>UserRepo: member rows
    deactivate DB
    UserRepo-->>MemberSvc: memberEntities
    deactivate UserRepo
    MemberSvc-->>MembersAPI: User[]
    deactivate MemberSvc
    MembersAPI-->>Web: ApiResponseDto(UserResponse[])
    deactivate MembersAPI
    Web-->>Admin: Render member list

    %% Stage 2: Admin adds a new member directly
    Admin->>Web: Search user & click "Add"
    Web->>MembersAPI: POST /group/:id/members { userId, role }
    activate MembersAPI
    MembersAPI->>MemberSvc: addUserToGroup(userId, groupId, addedById)
    activate MemberSvc
    MemberSvc->>CLS: get("profile")
    CLS-->>MemberSvc: { id: adminId }
    MemberSvc->>UserGroupRepo: findOne({ userId, groupId })
    activate UserGroupRepo
    UserGroupRepo->>DB: SELECT user_group WHERE userId & groupId
    DB-->>UserGroupRepo: existingMembership?
    deactivate UserGroupRepo
    alt Already a member
        MemberSvc-->>MembersAPI: existing record
    else Not yet a member
        MemberSvc->>UserGroupRepo: save({ userId, groupId, addedById: adminId })
        activate UserGroupRepo
        UserGroupRepo->>DB: INSERT user_group
        DB-->>UserGroupRepo: persisted row
        deactivate UserGroupRepo
        MemberSvc-->>MembersAPI: UserGroupEntity
    end
    deactivate MemberSvc
    MembersAPI-->>Web: ApiResponseDto(UserGroupResponse)
    deactivate MembersAPI
    Web-->>Admin: Show success toast & refresh table

    %% Stage 3: Admin removes an existing member
    Admin->>Web: Click "Remove" next to member
    Web->>MembersAPI: DELETE /group/:id/members/:userId
    activate MembersAPI
    MembersAPI->>MemberSvc: removeMemberByGroupAndUser({ userId })
    activate MemberSvc
    MemberSvc->>CLS: get("group")
    CLS-->>MemberSvc: { id: groupId }
    MemberSvc->>UserGroupRepo: findOne({ groupId, userId })
    activate UserGroupRepo
    UserGroupRepo->>DB: SELECT user_group WHERE groupId & userId
    DB-->>UserGroupRepo: membership?
    deactivate UserGroupRepo
    alt Member not found
        MemberSvc-->>MembersAPI: throw MemberNotFoundError
        MembersAPI-->>Web: 404 + error message
        Web-->>Admin: Display "Member not found"
    else Member exists
        MemberSvc->>InviteRepo: delete({ groupId, toUserId: userId })
        activate InviteRepo
        InviteRepo->>DB: DELETE group_invitations
        DB-->>InviteRepo: ok
        deactivate InviteRepo
        MemberSvc->>UserGroupRepo: remove(member)
        activate UserGroupRepo
        UserGroupRepo->>DB: DELETE user_group
        DB-->>UserGroupRepo: ok
        deactivate UserGroupRepo
        MemberSvc-->>MembersAPI: void
        MembersAPI-->>Web: ApiMessageResponse "Member removed"
        Web-->>Admin: Update UI + success toast
    end
    deactivate MemberSvc
    deactivate MembersAPI