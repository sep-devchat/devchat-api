---
config:
  themeCSS: >-
    .actor-line{stroke-dasharray:6 6;}.actor-bottom,
    text.actor-bottom{display:none;}
  theme: neo
---
sequenceDiagram
    autonumber
    actor Owner as owner:GroupOwner
    actor Member as member:GroupMember
    participant Web as web:TaskBoardUI
    participant TaskAPI as api:TaskController
    participant GuardGroup as guard:GroupGuard
    participant GuardOwner as guardOwner:GroupOwnerGuard
    participant TaskSvc as svc:TaskService
    participant CLS as cls:ClsService<DevChatCls>
    participant GroupSvc as groupSvc:GroupService
    participant UserSvc as userSvc:UserService
    participant UserGroupSvc as memberSvc:UserGroupService
    participant TaskRepo as repo:TaskRepository
    participant DB as db:Database

    %% Stage 1: Owner creates a task
    Owner->>Web: Fill form & click "Create Task"
    Web->>TaskAPI: POST /group/:id/task {name, assigneeId,...}
    TaskAPI->>GuardGroup: ensureMember()
    GuardGroup-->>TaskAPI: ok
    TaskAPI->>GuardOwner: ensureOwner()
    GuardOwner-->>TaskAPI: ok
    TaskAPI->>TaskSvc: createOne(dto)
    activate TaskSvc
    TaskSvc->>CLS: get("group") & get("profile")
    CLS-->>TaskSvc: { groupId, userId }
    TaskSvc->>GroupSvc: findOne(groupId)
    GroupSvc-->>TaskSvc: groupEntity
    TaskSvc->>UserSvc: findById(assigneeId)
    UserSvc-->>TaskSvc: assignee
    TaskSvc->>UserGroupSvc: isMember(groupId, assigneeId)
    UserGroupSvc-->>TaskSvc: true/false
    alt Assignee not in group
        TaskSvc-->>TaskAPI: throw AssigneeIsNotGroupMember
        TaskAPI-->>Web: 400 + error
        Web-->>Owner: Show validation error
    else Valid assignee
        TaskSvc->>TaskRepo: insert(newTask)
        TaskRepo->>DB: INSERT task row
        DB-->>TaskRepo: persistedTask
        TaskRepo-->>TaskSvc: TaskEntity
        TaskSvc-->>TaskAPI: TaskEntity
        TaskAPI-->>Web: ApiResponseDto(TaskResponse)
        Web-->>Owner: Render created task card
    end
    deactivate TaskSvc

    %% Stage 2: Owner updates or deletes task details
    Owner->>Web: Edit fields & submit
    Web->>TaskAPI: PUT /group/:id/task/:taskId
    TaskAPI->>GuardGroup: ensureMember()
    GuardGroup-->>TaskAPI: ok
    TaskAPI->>GuardOwner: ensureOwner()
    GuardOwner-->>TaskAPI: ok
    TaskAPI->>TaskSvc: updateOne(taskId,dto)
    activate TaskSvc
    TaskSvc->>TaskRepo: findOne(taskId)
    TaskRepo->>DB: SELECT task
    DB-->>TaskRepo: TaskEntity
    TaskRepo-->>TaskSvc: TaskEntity
    alt Assignee changed
        TaskSvc->>UserSvc: findById(newAssignee)
        UserSvc-->>TaskSvc: user
        TaskSvc->>UserGroupSvc: isMember(groupId,newAssignee)
        UserGroupSvc-->>TaskSvc: true/false
        alt Not member
            TaskSvc-->>TaskAPI: throw AssigneeIsNotGroupMember
            TaskAPI-->>Web: 400 error
            Web-->>Owner: Prompt choose valid member
        else Member OK
            TaskSvc->>TaskRepo: update(taskId,dto)
            TaskRepo->>DB: UPDATE task
            DB-->>TaskRepo: ok
            TaskSvc-->>TaskAPI: updatedTask
            TaskAPI-->>Web: ApiResponseDto(TaskResponse)
            Web-->>Owner: Show updated task
        end
    else Assignee unchanged
        TaskSvc->>TaskRepo: update(taskId,dto)
        TaskRepo->>DB: UPDATE task
        DB-->>TaskRepo: ok
        TaskSvc-->>TaskAPI: updatedTask
        TaskAPI-->>Web: ApiResponseDto(TaskResponse)
        Web-->>Owner: Show updated task
    end
    deactivate TaskSvc

    %% Stage 3: Member lists tasks with filters
    Member->>Web: Apply filters & refresh board
    Web->>TaskAPI: GET /group/:id/task?query
    TaskAPI->>GuardGroup: ensureMember()
    GuardGroup-->>TaskAPI: ok
    TaskAPI->>TaskSvc: findByGroup(query)
    activate TaskSvc
    TaskSvc->>CLS: get("group")
    CLS-->>TaskSvc: { groupId }
    TaskSvc->>TaskRepo: findAndCount(where=queryFilters)
    TaskRepo->>DB: SELECT tasks + COUNT
    DB-->>TaskRepo: task rows & total
    TaskRepo-->>TaskSvc: [tasks,total]
    TaskSvc-->>TaskAPI: { data,pagination }
    TaskAPI-->>Web: ApiResponseDto(TaskResponse[])
    Web-->>Member: Render filtered task list
    deactivate TaskSvc

    %% Stage 4: Member updates task status only
    Member->>Web: Move card to "Done"
    Web->>TaskAPI: PUT /group/:id/task/:taskId/status { status }
    TaskAPI->>GuardGroup: ensureMember()
    GuardGroup-->>TaskAPI: ok
    TaskAPI->>TaskSvc: updateTaskStatus(taskId,dto)
    activate TaskSvc
    TaskSvc->>TaskRepo: findOne(taskId)
    TaskRepo->>DB: SELECT task
    DB-->>TaskRepo: TaskEntity
    TaskRepo-->>TaskSvc: TaskEntity
    TaskSvc->>TaskRepo: update(taskId,{ status })
    TaskRepo->>DB: UPDATE status
    DB-->>TaskRepo: ok
    TaskRepo-->>TaskSvc: updatedTask
    TaskSvc-->>TaskAPI: updatedTask
    TaskAPI-->>Web: ApiResponseDto(TaskResponse)
    Web-->>Member: Reflect new status across board
    deactivate TaskSvc

    %% Stage 5: Owner soft deletes a task
    Owner->>Web: Click "Delete"
    Web->>TaskAPI: DELETE /group/:id/task/:taskId
    TaskAPI->>GuardGroup: ensureMember()
    GuardGroup-->>TaskAPI: ok
    TaskAPI->>GuardOwner: ensureOwner()
    GuardOwner-->>TaskAPI: ok
    TaskAPI->>TaskSvc: deleteOne(taskId)
    activate TaskSvc
    TaskSvc->>TaskRepo: findOne(taskId)
    TaskRepo->>DB: SELECT task
    DB-->>TaskRepo: TaskEntity
    TaskRepo-->>TaskSvc: TaskEntity
    TaskSvc->>TaskRepo: update(taskId,{ isActive:false })
    TaskRepo->>DB: UPDATE isActive
    DB-->>TaskRepo: ok
    TaskSvc-->>TaskAPI: { message: "Task deleted successfully" }
    TaskAPI-->>Web: ApiResponseDto(null)
    Web-->>Owner: Remove card & show toast
    deactivate TaskSvc