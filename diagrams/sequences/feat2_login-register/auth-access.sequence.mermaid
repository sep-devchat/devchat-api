%%{init: {"themeCSS": ".actor-line{stroke-dasharray:6 6;}.actor-bottom, text.actor-bottom{display:none;}"}}%%
sequenceDiagram
    autonumber
    actor C as Client
    participant AG as authGuard:Auth
    participant AS as authService:Auth
    participant DB as Database
    participant Controller

    C->>AG: Request with token
    activate AG
    AG->>AS: Validate token
    activate AS
    AS->>AS: Decode & verify token
    alt Invalid token
        AS-->>AG: Token invalid
        AG-->>C: Access denied
    else Valid token
        AS->>DB: Find user
        activate DB
        DB-->>AS: Query result
        deactivate DB
        alt User not found
            AS-->>AG: User not found
            AG-->>C: Access denied
        else User found
            AS->>AS: Check permissions
            alt Insufficient permissions
                AS-->>AG: Permission denied
                AG-->>C: Access denied
            else Sufficient permissions
                AS-->>AG: Token valid
                AG->>Controller: Forward request
                activate Controller
                Controller-->>C: Access granted
                deactivate Controller
                AG-->>C: Access granted
            end
        end
    end
    deactivate AS
    deactivate AG


