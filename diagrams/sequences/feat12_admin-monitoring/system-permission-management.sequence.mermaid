---
config:
  themeCSS: >-
    .actor-line{stroke-dasharray:6 6;}.actor-bottom,
    text.actor-bottom{display:none;}
  theme: neo
---
sequenceDiagram
    autonumber
    actor Admin as admin:SystemAdmin
    participant Console as web:AdminConsoleUI
    participant AdminAPI as api:AdminRoutes
    participant AuthGuard as guard:AuthGuard
    participant RoleGuard as adminGuard:AdminRoleGuard
    participant PermGuard as perm:RequirePermissionsGuard
    participant Audit as audit:AuditLogInterceptor
    participant PermissionSvc as permSvc:PermissionService
    participant PermissionRepo as permRepo:PermissionRepository
    participant AuditRepo as auditRepo:AuditLogRepository
    participant DB as db:Database

    Admin->>Console: Pick "Permissions" & action (create/update/delete/list)
    Console->>AdminAPI: HTTPS /permission { payload }
    AdminAPI->>AuthGuard: verifyAccessToken()
    AuthGuard-->>AdminAPI: authContext
    AdminAPI->>RoleGuard: ensureSystemAdmin()
    RoleGuard-->>AdminAPI: ok
    AdminAPI->>PermGuard: check(AdminPermissionEnum.MANAGE_PERMISSIONS)
    PermGuard-->>AdminAPI: allowed
    AdminAPI->>Audit: attachAuditContext("Permission", action)
    Audit-->>AdminAPI: continue request

    AdminAPI->>PermissionSvc: handlePermissionAction(dto)
    PermissionSvc->>PermissionRepo: persistPermission()
    PermissionRepo->>DB: INSERT/UPDATE permission row
    DB-->>PermissionRepo: persisted entity
    PermissionRepo-->>PermissionSvc: PermissionEntity
    PermissionSvc-->>AdminAPI: ApiResponseDto

    Audit->>AuditRepo: recordAction(adminId,"Permission",action)
    AuditRepo->>DB: INSERT audit_log
    AdminAPI-->>Console: ApiResponseDto(result,message)
    Console-->>Admin: Render toast + refresh permission grid